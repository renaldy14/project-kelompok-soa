meta {
  name: Ambil barang berdasarkan ID
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/products/{{productId}}
  body: none
  auth: none
}

tests {
  test("Ambil barang berdasarkan ID", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.id).to.equal(bru.getVar('productId'));
    expect(res.getBody().data.product_name).to.equal('Headset Gaming');
  });
}
