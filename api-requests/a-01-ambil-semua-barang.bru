meta {
  name: a-01 Ambil semua barang
  type: http
  seq: 1
}

get {
  url: http://127.0.0.1:5001/api/products
  body: none
  auth: none
}

script:post-response {
  const products = res.getBody().data;

  if (Array.isArray(products) && products.length > 0) {
    bru.setVar("productId", products[0].id);
  }
}

tests {
  test("Ambil semua barang", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Daftar barang berhasil diambil");
    expect(res.getBody().data).to.be.an('array');
  });
}
