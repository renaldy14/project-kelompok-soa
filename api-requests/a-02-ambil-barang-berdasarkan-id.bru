meta {
  name: a-02 Ambil barang berdasarkan ID
  type: http
  seq: 2
}

get {
  url: http://127.0.0.1:5001/api/products/{{productId}}
  body: none
  auth: none
}

tests {
  test("Ambil barang berdasarkan ID", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Detail barang berhasil diambil");
    expect(res.getBody().data.id).to.equal(bru.getVar('productId'));
  });
}
