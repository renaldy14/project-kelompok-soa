meta {
  name: a-04 Ubah barang
  type: http
  seq: 4
}

put {
  url: http://127.0.0.1:5001/api/products/{{productId}}
  body: json
  auth: none
}

body:json {
  {
    "product_name": "Headset Wireless",
    "category": "Aksesoris",
    "quantity": 12
  }
}

tests {
  test("Ubah barang", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.product_name).to.equal('Headset Wireless');
    expect(res.getBody().data.quantity).to.equal(12);
  });
}
