  body: json
  auth: none
}

body:json {
  {
    "product_name": "Headset Gaming",
    "category": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "quantity": 10
  }
}

tests {
  test("Tolak kategori terlalu panjang", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("Kategori maksimal 100 karakter");
    expect(res.getBody().data).to.equal(null);
  });
}
