meta {
  name: Tolak quantity negatif
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: none
}

body:json {
  {
    "product_name": "Headset Gaming",
    "category": "Aksesoris",
    "quantity": -1
  }
}

tests {
  test("Tolak quantity negatif", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("Quantity tidak boleh kurang dari 0");
    expect(res.getBody().data).to.equal(null);
  });
}
